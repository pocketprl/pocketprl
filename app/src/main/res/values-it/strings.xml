    <!-- ===================== welcome ===================== -->
    <string name="welcome_add_title">Aggiungi un portafoglio</string>
    <string name="welcome_add_headline">Un altro portafoglio, del tutto separato</string>
    <string name="welcome_add_body">Ha una sua frase di recupero, password, cronologia e contatti. Passa da un portafoglio all’altro dal titolo della schermata iniziale.</string>
