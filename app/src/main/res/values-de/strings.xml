    <!-- ===================== welcome ===================== -->
    <string name="welcome_add_title">Wallet hinzufügen</string>
    <string name="welcome_add_headline">Ein weiteres Wallet, völlig getrennt</string>
    <string name="welcome_add_body">Eigene Wiederherstellungsphrase, eigenes Passwort, eigene Historie und Kontakte. Wechsle zwischen Wallets über den Titel auf dem Startbildschirm.</string>
    <string name="welcome_one_unlocked">Es ist immer nur ein Wallet entsperrt; beim Wechseln wird das aktuelle gesperrt.</string>
    <string name="welcome_tagline">Pearl (PRL) für die Hosentasche. Dieselben Schlüssel wie das Desktop-Wallet, ohne den Ballast.</string>
    <string name="welcome_feature_selfcustody_title">Eigenverwahrung</string>
    <string name="welcome_feature_selfcustody_body">Die Schlüssel werden auf diesem Telefon erstellt und bleiben dort, verschlüsselt und durch Biometrie geschützt.</string>
    <string name="welcome_feature_desktop_title">Desktop-kompatibel</string>
    <string name="welcome_feature_desktop_body">Leitet exakt dieselben post-quanten Taproot-Adressen ab wie oyster. Wechsle frei zwischen beiden.</string>
    <string name="welcome_feature_overview_title">Sofortiger Überblick</string>
    <string name="welcome_feature_overview_body">Guthaben, Historie und Mining-Belohnungen vom Pearl-Indexer. Kein Chain-Download.</string>
    <string name="welcome_feature_phone_title">Für ein Telefon gemacht</string>
    <string name="welcome_feature_phone_body">Zahlungslinks, Kontakte, Notizen, mehrere Wallets und „Du wurdest bezahlt“-Benachrichtigungen.</string>
    <string name="welcome_network">Netzwerk</string>
    <string name="welcome_create">Neues Wallet erstellen</string>
    <string name="welcome_restore">Aus Wiederherstellungsphrase wiederherstellen</string>

